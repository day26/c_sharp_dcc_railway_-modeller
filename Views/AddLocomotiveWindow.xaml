<Window x:Class="DccController.Views.AddLocomotiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Locomotive" 
        Height="700" Width="450"
        Background="#1E1E2E"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- Title -->
            <TextBlock Text="Add New Locomotive"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

            <!-- Name -->
            <TextBlock Text="Locomotive Name:" Foreground="White" Margin="0,5,0,2"/>
            <TextBox x:Name="NameTextBox"
                 Background="#2E2E3E"
                 Foreground="White"
                 BorderBrush="#555"
                 Padding="5"
                 Margin="0,0,0,10"/>

            <!-- DCC Address -->
            <TextBlock Text="DCC Address (1-9999):" Foreground="White" Margin="0,5,0,2"/>
            <TextBox x:Name="DccAddressTextBox"
                 Background="#2E2E3E"
                 Foreground="White"
                 BorderBrush="#555"
                 Padding="5"
                 Margin="0,0,0,10"/>

            <!-- Manufacturer -->
            <TextBlock Text="Manufacturer:" Foreground="White" Margin="0,5,0,2"/>
            <ComboBox x:Name="ManufacturerComboBox"
                  Background="#2E2E3E"
                  Foreground="White"
                  BorderBrush="#555"
                  Padding="5"
                  Margin="0,0,0,10">
                <ComboBoxItem Content="Hornby"/>
                <ComboBoxItem Content="Bachmann"/>
                <ComboBoxItem Content="Heljan"/>
                <ComboBoxItem Content="Dapol"/>
                <ComboBoxItem Content="Accurascale"/>
                <ComboBoxItem Content="Hattons"/>
                <ComboBoxItem Content="Other"/>
            </ComboBox>

            <!-- Class -->
            <TextBlock Text="Locomotive Class:" Foreground="White" Margin="0,5,0,2"/>
            <TextBox x:Name="ClassTextBox"
                 Background="#2E2E3E"
                 Foreground="White"
                 BorderBrush="#555"
                 Padding="5"
                 Margin="0,0,0,10"/>

            <!-- Photo -->
            <TextBlock Text="Photo:" Foreground="White" Margin="0,5,0,2"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ImagePathTextBox"
                     Grid.Column="0"
                     Background="#2E2E3E"
                     Foreground="White"
                     BorderBrush="#555"
                     Padding="5"
                     IsReadOnly="True"/>
                <Button Content="Browse..."
                    x:Name="BrowseImageButton"
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    Background="#2E2E3E"
                    Foreground="White"
                    Click="BrowseImageButton_Click"/>
            </Grid>

            <!-- Image Preview -->
            <Border Background="#2E2E3E" 
                Height="100" 
                Margin="0,0,0,10"
                BorderBrush="#555"
                BorderThickness="1">
                <Image x:Name="LocoImagePreview"
                   Stretch="Uniform"
                   Margin="5"/>
            </Border>

            <!-- Notes -->
            <TextBlock Text="Notes:" Foreground="White" Margin="0,5,0,2"/>
            <TextBox x:Name="NotesTextBox"
                 Background="#2E2E3E"
                 Foreground="White"
                 BorderBrush="#555"
                 Padding="5"
                 Height="60"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Margin="0,0,0,15"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                    x:Name="CancelButton"
                    Width="80" Height="35"
                    Margin="0,0,10,0"
                    Background="#555"
                    Foreground="White"
                    Click="CancelButton_Click"/>
                <Button Content="Add Locomotive"
                    x:Name="AddButton"
                    Width="130" Height="35"
                    Background="#27AE60"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="AddButton_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>